<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Pontinhos do canto superior esquerdo -->
    <ImageView
        android:id="@+id/bgDots"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:alpha="0.35"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Hexágonos do canto superior direito -->
    <ImageView
        android:id="@+id/bgHex"
        android:layout_width="220dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="110dp"
        android:layout_marginEnd="-22dp"
        android:alpha="0.28"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Ondas inferiores -->
    <ImageView
        android:id="@+id/bgWaveBottomLeft"
        android:layout_width="340dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-90dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.42"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ImageView
        android:id="@+id/bgWaveBottomRight"
        android:layout_width="340dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.42"
        android:rotationY="180"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="34dp"
            android:paddingBottom="14dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/logo_dermaprev"
                android:scaleType="fitCenter"
                android:contentDescription="Logo DermaPrev" />

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DermaPrev"
                android:textColor="#063B78"
                android:textSize="42sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03" />

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="310dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Triagem inteligente para cuidar\nda sua pele com apoio da IA"
                android:textColor="#5F7188"
                android:textSize="14sp" />

            <!-- Card principal -->
            <LinearLayout
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_login"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/txtMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Criar conta"
                    android:textColor="#063B78"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Nome completo -->
                <LinearLayout
                    android:id="@+id/containerName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_shield_lock_dermaprev"
                        app:tint="#60738A" />

                    <EditText
                        android:id="@+id/edtName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Nome completo"
                        android:inputType="textPersonName"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp"
                        android:textColor="#102A43"
                        android:textColorHint="#7B8794"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- E-mail -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_email_dermaprev"
                        app:tint="#60738A" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="E-mail"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp"
                        android:textColor="#102A43"
                        android:textColorHint="#7B8794"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Senha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock_dermaprev"
                        app:tint="#60738A" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Senha"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="10dp"
                        android:textColor="#102A43"
                        android:textColorHint="#7B8794"
                        android:textSize="17sp" />

                    <ImageView
                        android:id="@+id/imgEye"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_eye_dermaprev"
                        app:tint="#60738A" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="Esqueci minha senha"
                    android:textColor="#075BD8"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/checkTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="#08AFC0"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button_primary_dermaprev"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Entrar"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_outline_dermaprev"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Criar conta"
                    android:textColor="#075BD8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Segurança -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_shield_lock_dermaprev"
                    app:tint="#08AFC0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Acesso seguro e protegido"
                    android:textColor="#075BD8"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="#D5E5F4" />

            <TextView
                android:id="@+id/txtWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Ao continuar, você concorda com os Termos e a Política de Privacidade."
                android:textColor="#68798F"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>