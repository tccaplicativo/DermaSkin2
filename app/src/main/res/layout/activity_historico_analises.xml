<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHistorico"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Pontinhos -->
    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="2dp"
        android:layout_marginTop="8dp"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Hexágonos -->
    <ImageView
        android:layout_width="190dp"
        android:layout_height="230dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="-28dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Ondas inferiores -->
    <ImageView
        android:layout_width="330dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-95dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ImageView
        android:layout_width="330dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-95dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:rotationY="180"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- Marca -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="Logo DermaPrev"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_dermaprev" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Derma"
                        android:textColor="#063B78"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prev"
                        android:textColor="#1DB9D2"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Histórico de análises"
                android:textColor="#063B78"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Consulte as triagens realizadas anteriormente e acompanhe seus registros."
                android:textColor="#50627A"
                android:textSize="14sp" />

            <!-- Estado vazio -->
            <LinearLayout
                android:id="@+id/layoutEstadoVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_login"
                android:elevation="7dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="30dp"
                android:paddingEnd="24dp"
                android:paddingBottom="30dp">


                <TextView
                    android:id="@+id/txtEstadoVazioTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:text="Nenhuma análise realizada ainda"
                    android:textColor="#063B78"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEstadoVazioDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Quando você concluir sua primeira triagem, ela aparecerá aqui."
                    android:textColor="#50627A"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Histórico real -->
            <LinearLayout
                android:id="@+id/containerHistorico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <!-- Aviso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_login"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#0A4BCF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Atenção"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="O histórico auxilia no acompanhamento das triagens, mas não substitui avaliação ou acompanhamento médico."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnNovaAnaliseHistorico"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Fazer nova análise"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVoltarHistorico"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_dermaprev"
                android:backgroundTint="@null"
                android:text="Voltar ao início"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>