<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_mais"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <!-- BARRINHA SUPERIOR -->

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D8E1EC" />

    <!-- TÍTULO -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Informações"
        android:textColor="#063B78"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Informações e ajuda sobre o DermaPrev"
        android:textColor="#50627A"
        android:textSize="13sp" />


    <!-- SOBRE O DERMAPREV -->

    <LinearLayout
        android:id="@+id/btnSobreDermaPrev"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_input_dermaprev"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_white_dermaprev"
            android:gravity="center"
            android:text="!"
            android:textColor="#0A4BCF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sobre o DermaPrev"
                android:textColor="#063B78"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Conheça o objetivo do aplicativo"
                android:textColor="#50627A"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_forward_dermaprev"
            app:tint="#0A4BCF" />

    </LinearLayout>


    <!-- COMO USAR -->

    <LinearLayout
        android:id="@+id/btnComoUsarDermaPrev"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_dermaprev"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_white_dermaprev"
            android:gravity="center"
            android:text="\?"
            android:textColor="#0A4BCF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Como usar o DermaPrev"
                android:textColor="#063B78"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Veja rapidamente como utilizar o aplicativo"
                android:textColor="#50627A"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_forward_dermaprev"
            app:tint="#0A4BCF" />

    </LinearLayout>


    <!-- DÚVIDAS OU SUGESTÕES -->

    <LinearLayout
        android:id="@+id/btnContatoDermaPrev"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_dermaprev"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_white_dermaprev"
            android:gravity="center"
            android:text="\@"
            android:textColor="#0A4BCF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dúvidas ou sugestões"
                android:textColor="#063B78"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="dermaprev.app@gmail.com"
                android:textColor="#50627A"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_forward_dermaprev"
            app:tint="#0A4BCF" />

    </LinearLayout>

</LinearLayout>