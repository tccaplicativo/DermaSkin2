<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSelecionarArea"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Fundo: pontinhos -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Fundo: hexágonos -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="-26dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Fundo: ondas -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Topo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoltarArea"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_card_login"
                android:backgroundTint="@null"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="28sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Selecionar área"
                android:textColor="#0A3D91"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_card_login"
                android:gravity="center"
                android:text="1/4"
                android:textColor="#0A4BCF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Toque na região do corpo onde está a lesão"
            android:textColor="#4F6480"
            android:textSize="14sp" />

        <!-- Área da silhueta com pontos clicáveis -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/imgBodySilhouette"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="Silhueta do corpo humano"
                android:scaleType="fitCenter"
                android:src="@drawable/body_silhouette_dermaprev" />

            <!-- Rosto -->
            <LinearLayout
                android:id="@+id/btnRosto"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- Pescoço -->
            <LinearLayout
                android:id="@+id/btnPescoco"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="102dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- Peito -->
            <LinearLayout
                android:id="@+id/btnPeito"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="158dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- Barriga -->
            <LinearLayout
                android:id="@+id/btnBarriga"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="228dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- Braço -->
            <LinearLayout
                android:id="@+id/btnBraco"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="205dp"
                android:orientation="horizontal"
                android:translationX="-86dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true">
            </LinearLayout>

            <!-- Mão -->
            <LinearLayout
                android:id="@+id/btnMao"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="322dp"
                android:orientation="horizontal"
                android:translationX="-108dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true">
            </LinearLayout>

            <!-- Costas / tronco lateral -->
            <LinearLayout
                android:id="@+id/btnCostas"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="172dp"
                android:orientation="horizontal"
                android:translationX="52dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true">
            </LinearLayout>

            <!-- Perna -->
            <LinearLayout
                android:id="@+id/btnPerna"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="402dp"
                android:orientation="horizontal"
                android:translationX="42dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true">
            </LinearLayout>

            <!-- Pé -->
            <LinearLayout
                android:id="@+id/btnPe"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="34dp"
                android:orientation="horizontal"
                android:translationX="46dp"
                android:background="@drawable/bg_area_point_dermaprev"
                android:clickable="true"
                android:focusable="true">
            </LinearLayout>

            <!-- Outra área -->
        <LinearLayout
            android:id="@+id/btnOutraArea"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_card_login"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#0A4BCF"
                android:textSize="22sp"
                android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/txtAreaSelecionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Nenhuma área selecionada"
            android:textColor="#4F6480"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnContinuarArea"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary_dermaprev"
            android:backgroundTint="@null"
            android:text="Continuar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</FrameLayout>