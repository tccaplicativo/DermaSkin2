<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- DECORAÇÃO -->

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:alpha="0.25"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="-26dp"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <!-- TOPO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVoltarMonitoramento"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_card_login"
                    android:contentDescription="Voltar"
                    android:elevation="3dp"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_chevron_left"
                    app:tint="#0A4BCF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Acompanhar lesões"
                    android:textColor="#0A3D91"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="46dp"
                    android:layout_height="46dp" />

            </LinearLayout>

            <!-- CABEÇALHO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Acompanhe suas lesões"
                android:textColor="#0A3D91"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Compare registros da mesma lesão ao longo do tempo."
                android:textColor="#687990"
                android:textSize="13sp" />

            <!-- NOVO ACOMPANHAMENTO -->

            <LinearLayout
                android:id="@+id/btnNovoAcompanhamento"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_monitoramento_dermaprev"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_white_dermaprev">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add_monitoramento"
                        app:tint="#2E8B67" />

                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Iniciar novo acompanhamento"
                    android:textColor="#174D3B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_forward_dermaprev"
                    app:tint="#2E8B67" />

            </LinearLayout>

            <!-- TÍTULO DA LISTA -->

            <TextView
                android:id="@+id/txtTituloAcompanhamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Em acompanhamento"
                android:textColor="#0A3D91"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- CARREGANDO -->

            <TextView
                android:id="@+id/txtCarregandoMonitoramentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Carregando acompanhamentos..."
                android:textColor="#687990"
                android:textSize="13sp" />

            <!-- ESTADO VAZIO -->

            <LinearLayout
                android:id="@+id/layoutSemMonitoramentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_login"
                android:elevation="3dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_circle_white_dermaprev"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_evolucao_monitoramento"
                        app:tint="#2E8B67" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Nenhuma lesão em acompanhamento"
                    android:textColor="#0A3D91"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Escolha uma análise já realizada para começar a acompanhar a mesma lesão ao longo do tempo."
                    android:textColor="#687990"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- CARDS CRIADOS PELO KOTLIN -->

            <LinearLayout
                android:id="@+id/containerMonitoramentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- INFORMAÇÃO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_login"
                android:elevation="3dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_white_dermaprev">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera_monitoramento"
                        app:tint="#2E8B67" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Importante"
                        android:textColor="#0A3D91"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Procure fotografar sempre a mesma lesão, mantendo distância, iluminação e posição semelhantes entre os registros."
                        android:textColor="#687990"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>