<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- DECORAÇÃO DERMAPREV -->

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:alpha="0.25"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="-26dp"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="38dp">

            <!-- TOPO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVoltarEncaminhamento"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_card_login"
                    android:contentDescription="Voltar"
                    android:elevation="3dp"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_chevron_left"
                    app:tint="#0A4BCF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Encaminhamento"
                    android:textColor="#063B78"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="46dp"
                    android:layout_height="46dp" />

            </LinearLayout>

            <!-- PROCURE ATENDIMENTO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_home_primary_light_dermaprev"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle_white_dermaprev"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_encaminhamento"
                        app:tint="#D47A32" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Procure atendimento"
                        android:textColor="#063B78"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="A triagem do aplicativo ajuda a organizar as informações, mas a avaliação deve ser realizada por um profissional de saúde."
                        android:textColor="#50627A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- QUANDO BUSCAR -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Quando buscar atendimento?"
                android:textColor="#063B78"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_login"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Procure uma UBS, clínica ou dermatologista se perceber:"
                    android:textColor="#D47A32"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:lineSpacingExtra="4dp"
                    android:text="• Mancha ou pinta que aumenta de tamanho.\n\n• Mudança de cor, formato ou bordas.\n\n• Sangramento sem causa aparente.\n\n• Coceira persistente.\n\n• Ferida que não cicatriza.\n\n• Dor ou sensibilidade.\n\n• Triagem indicando nível de atenção moderado ou elevado."
                    android:textColor="#50627A"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ONDE BUSCAR -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Onde buscar atendimento"
                android:textColor="#063B78"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_login"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="Use as opções abaixo para localizar serviços de saúde próximos ou entrar em contato com canais públicos de orientação."
                    android:textColor="#50627A"
                    android:textSize="12sp" />

                <!-- SEPARADOR -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#E9EEF5" />

                <!-- UBS -->

                <LinearLayout
                    android:id="@+id/btnBuscarUbs"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_card_encaminhamento_dermaprev"
                    android:backgroundTint="#3E77B6"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_white_dermaprev">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_encaminhamento"
                            app:tint="#3E77B6" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Buscar UBS próxima"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_forward_dermaprev"
                        app:tint="#FFFFFF" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <!-- DERMATOLOGISTA -->

                <LinearLayout
                    android:id="@+id/btnBuscarDermatologista"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_card_orientacoes_dermaprev"
                    android:backgroundTint="#90B1DB"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_white_dermaprev">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_profile_nav"
                            app:tint="#0A4BCF" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Buscar dermatologista próximo"
                        android:textColor="#063B78"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_forward_dermaprev"
                        app:tint="#063B78" />

                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <!-- DISQUE SAÚDE -->

                <LinearLayout
                    android:id="@+id/btnLigarSus"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_card_orientacoes_dermaprev"
                    android:backgroundTint="#BBD2EC"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_white_dermaprev">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_orientacoes"
                            app:tint="#0A4BCF" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Ligar para Disque Saúde 136"
                        android:textColor="#063B78"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_forward_dermaprev"
                        app:tint="#0A4BCF" />

                </LinearLayout>

            </LinearLayout>

            <!-- LEVE SEU RELATÓRIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_login"
                android:elevation="3dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_relatorio"
                        app:tint="#0A4BCF" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Leve seu relatório"
                        android:textColor="#063B78"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Se você gerou um relatório no DermaPrev, ele pode ajudar a apresentar a foto, a localização da lesão e as informações relatadas durante a triagem."
                        android:textColor="#50627A"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- PERFIL E PRIVACIDADE -->

            <LinearLayout
                android:id="@+id/btnPerfilPrivacidade"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="17dp"
                android:paddingEnd="17dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_nav"
                    app:tint="#0A4BCF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Perfil e privacidade"
                    android:textColor="#063B78"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_forward_dermaprev"
                    app:tint="#0A4BCF" />

            </LinearLayout>

            <!-- AVISO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="O DermaPrev auxilia na triagem e organização das informações, mas não realiza diagnóstico e não substitui avaliação profissional."
                android:textColor="#50627A"
                android:textSize="10sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>