<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGuiaCaptura"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Fundo decorativo: pontinhos -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="8dp"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Fundo decorativo: hexágonos -->
    <ImageView
        android:layout_width="185dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-38dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Fundo decorativo: ondas inferiores -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:layout_gravity="bottom"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- Topo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Seta visual do topo -->
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#60738A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Marca -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Logo DermaPrev"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_dermaprev" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Derma"
                        android:textColor="#063B78"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prev"
                        android:textColor="#1DB9D2"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Progresso -->
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="2/4"
                    android:textColor="#0A4BCF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Guia de captura"
                android:textColor="#063B78"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Siga estas orientações antes de tirar a foto da lesão."
                android:textColor="#50627A"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <!-- Card principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Área da lesão -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_card_login"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:text="◎"
                        android:textColor="#0A4BCF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAreaSelecionadaGuia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Área da lesão: Não informada"
                        android:textColor="#063B78"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Linha divisória -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#DDECF7" />

                <!-- Checklist -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Checklist da foto ideal"
                    android:textColor="#063B78"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_primary_dermaprev"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Use boa iluminação natural ou um ambiente bem iluminado."
                        android:textColor="#173B70"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Item 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_primary_dermaprev"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Evite sombras fortes, reflexos e flash muito próximo."
                        android:textColor="#173B70"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Item 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_primary_dermaprev"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Centralize a lesão na marcação da câmera e mantenha o foco."
                        android:textColor="#173B70"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Item 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_button_primary_dermaprev"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Aproxime o suficiente para a lesão aparecer bem, sem perder nitidez."
                        android:textColor="#173B70"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Atenção -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_login"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#0A4BCF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Atenção"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="A triagem não confirma nem descarta diagnóstico médico. Em caso de suspeita, procure um dermatologista."
                        android:textColor="#50627A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Botão principal -->
            <Button
                android:id="@+id/btnContinuarCaptura"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Entendi, abrir câmera"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Botão voltar -->
            <Button
                android:id="@+id/btnVoltarGuia"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_dermaprev"
                android:backgroundTint="@null"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>