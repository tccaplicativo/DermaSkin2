<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRelatorioProfissional"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Pontinhos -->
    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="2dp"
        android:layout_marginTop="8dp"
        android:alpha="0.30"
        android:src="@drawable/bg_dots_dermaprev"
        android:contentDescription="@null" />

    <!-- Hexágonos -->
    <ImageView
        android:layout_width="190dp"
        android:layout_height="230dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="-28dp"
        android:alpha="0.18"
        android:src="@drawable/bg_hex_dermaprev"
        android:contentDescription="@null" />

    <!-- Ondas inferiores -->
    <ImageView
        android:layout_width="330dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-95dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.32"
        android:src="@drawable/bg_wave_bottom_dermaprev"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="330dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-95dp"
        android:layout_marginBottom="-12dp"
        android:alpha="0.32"
        android:rotationY="180"
        android:src="@drawable/bg_wave_bottom_dermaprev"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- Marca -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="Logo DermaPrev"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_dermaprev" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Derma"
                        android:textColor="#063B78"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prev"
                        android:textColor="#1DB9D2"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Relatório profissional"
                android:textColor="#063B78"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Resumo organizado para apoiar a comunicação com um profissional de saúde."
                android:textColor="#50627A"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- Resumo e imagem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_login"
                android:elevation="7dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumo para encaminhamento"
                    android:textColor="#063B78"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAreaRelatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:paddingStart="16dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="13dp"
                    android:text="Área da lesão: Não informada"
                    android:textColor="#063B78"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgRelatorioFoto"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_circle"
                    android:padding="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_skin_placeholder" />

            </LinearLayout>

            <!-- Resultado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="7dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resultado da triagem"
                    android:textColor="#063B78"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtResumoRelatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="Resumo do resultado"
                    android:textColor="#173B70"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Dados clínicos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="7dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dados clínicos informados"
                    android:textColor="#063B78"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtClinicoRelatorio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:text="Dados clínicos"
                    android:textColor="#173B70"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Aviso -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#0A4BCF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uso do relatório"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Leve este relatório a um profissional de saúde. Ele serve apenas como apoio à comunicação e não como diagnóstico médico."
                        android:textColor="#50627A"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Botões -->
            <Button
                android:id="@+id/btnExportarRelatorioPdf"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Exportar PDF"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnHistoricoRelatorio"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Ir para histórico"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVoltarRelatorio"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_dermaprev"
                android:backgroundTint="@null"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>