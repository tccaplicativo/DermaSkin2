<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootProcessamentoIa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7EFE8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DermaSkin"
            android:textColor="#4A2A1A"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Processamento com IA"
            android:textColor="#6B4A3A"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Analisando sua imagem"
                android:textColor="#4A2A1A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAreaProcessamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFF8F2"
                android:gravity="center"
                android:padding="14dp"
                android:text="Área selecionada: Área não informada"
                android:textColor="#4A2A1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressProcessamento"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="34dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/txtStatusProcessamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Preparando imagem para análise..."
                android:textColor="#3A2A24"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Estamos combinando a imagem capturada com as informações clínicas preenchidas no questionário."
                android:textColor="#6B4A3A"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFF8F2"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aviso importante"
                android:textColor="#B3261E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="A inteligência artificial realiza apenas uma triagem visual. O resultado não substitui diagnóstico médico e deve ser interpretado com cautela."
                android:textColor="#6B4A3A"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>