<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="11dp"
    android:background="@drawable/bg_card_login"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgRegistroEvolucao"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_card_monitoramento_dermaprev"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_skin_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTipoRegistroEvolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acompanhamento"
                android:textColor="#2E8B67"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDataRegistroEvolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="09/08/2026 • 14:30"
                android:textColor="#0A3D91"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNivelRegistroEvolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Nível de atenção moderado"
                android:textColor="#50627A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtScoreRegistroEvolucao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Score visual da IA: 32%"
                android:textColor="#687990"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnVerAnaliseRegistro"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_monitoramento_dermaprev"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ver análise"
            android:textColor="#174D3B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_chevron_forward_dermaprev"
            app:tint="#2E8B67" />

    </LinearLayout>

</LinearLayout>