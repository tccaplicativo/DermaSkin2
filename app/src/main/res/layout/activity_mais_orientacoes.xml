<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- DECORAÇÃO DERMAPREV -->

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:alpha="0.22"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="210dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="-30dp"
        android:alpha="0.08"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <!-- TOPO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVoltarMaisOrientacoes"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_card_login"
                    android:contentDescription="Voltar"
                    android:elevation="3dp"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_chevron_left"
                    app:tint="#0A4BCF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Mais orientações"
                    android:textColor="#063B78"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="Logo DermaPrev"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_dermaprev" />

            </LinearLayout>

            <!-- INTRODUÇÃO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Interessante para você"
                android:textColor="#063B78"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Conteúdos para conhecer melhor alguns temas relacionados à saúde da pele."
                android:textColor="#50627A"
                android:textSize="13sp" />

            <!-- ARTIGO 1 -->

            <LinearLayout
                android:id="@+id/cardArtigoMelanoma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#EAF3FF"
                    android:contentDescription="Artigo sobre melanoma"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_artigo_melanoma" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Você sabe onde o melanoma pode aparecer?"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Conheça melhor esse tipo de câncer de pele e algumas de suas características."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="INCA • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ARTIGO 2 -->

            <LinearLayout
                android:id="@+id/cardArtigoNaoMelanoma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Comparação entre tipos de câncer de pele"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_artigo_nao_melanoma" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nem todo câncer de pele é melanoma"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Entenda melhor o câncer de pele não melanoma e suas principais características."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="INCA • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ARTIGO 3 -->

            <LinearLayout
                android:id="@+id/cardArtigoDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#EAF3FF"
                    android:contentDescription="Consulta entre profissional de saúde e paciente"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_artigo_diagnostico" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="O que significa diagnóstico precoce?"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Entenda a diferença entre observar alterações, fazer triagem e receber um diagnóstico profissional."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ministério da Saúde • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <!-- ARTIGO 4 -->

            <LinearLayout
                android:id="@+id/cardArtigoDermatofibroma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:contentDescription="Sociedade Brasileira de Dermatologia"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_artigo_dermatofibroma" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dermatofibroma: uma lesão benigna que pode chamar atenção"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Conheça melhor essa lesão cutânea e suas principais características."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sociedade Brasileira de Dermatologia • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ARTIGO 5 -->

            <LinearLayout
                android:id="@+id/cardArtigoNevos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#EAF3FF"
                    android:contentDescription="Pessoa com pintas e sardas na pele"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_artigo_nevos" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Toda pinta diferente é melanoma?"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Conheça melhor os nevos displásicos e as diferenças entre alguns tipos de pintas."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sociedade Brasileira de Dermatologia • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ARTIGO 6 -->

            <LinearLayout
                android:id="@+id/cardArtigoCeratose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:contentDescription="Imagem microscópica relacionada à ceratose seborreica"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_artigo_ceratose" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="O que é ceratose seborreica?"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Descubra por que essa lesão benigna pode ter aparência e coloração variadas."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sociedade Brasileira de Dermatologia • Ler artigo"
                            android:textColor="#0A4BCF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_forward_dermaprev"
                            app:tint="#0A4BCF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- AVISO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Os conteúdos são educativos e serão abertos no navegador."
                android:textColor="#50627A"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>