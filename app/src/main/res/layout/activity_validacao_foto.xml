<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootValidacaoFoto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Fundo decorativo: pontinhos -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="8dp"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Fundo decorativo: hexágonos -->
    <ImageView
        android:layout_width="185dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-38dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Fundo decorativo: ondas inferiores -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:layout_gravity="bottom"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- Topo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#60738A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Logo DermaPrev"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_dermaprev" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Derma"
                        android:textColor="#063B78"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prev"
                        android:textColor="#1DB9D2"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="4/4"
                    android:textColor="#0A4BCF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Validar foto"
                android:textColor="#063B78"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Confira se a imagem está adequada antes de continuar para a análise."
                android:textColor="#50627A"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp" />

            <!-- Card principal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Área -->
                <TextView
                    android:id="@+id/txtAreaValidacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_dermaprev"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:text="Área da lesão: Não informada"
                    android:textColor="#063B78"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Foto -->
                <FrameLayout
                    android:layout_width="270dp"
                    android:layout_height="270dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="22dp">

                    <ImageView
                        android:id="@+id/imgValidacaoFoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle"
                        android:padding="8dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_skin_placeholder"
                        />

                    <View
                        android:layout_width="145dp"
                        android:layout_height="145dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_focus_ring" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:background="#80063B78"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="foto capturada"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Checklist -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="A foto está adequada?"
                    android:textColor="#063B78"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Marque os critérios abaixo antes de continuar."
                    android:textColor="#50627A"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

                <CheckBox
                    android:id="@+id/checkNitida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:buttonTint="@color/checkbox_tint_dermaprev"
                    android:text="A imagem está nítida e sem borrões."
                    android:textColor="#173B70"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/checkIluminada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="@color/checkbox_tint_dermaprev"
                    android:text="A pele está bem iluminada."
                    android:textColor="#173B70"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/checkCentralizada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="@color/checkbox_tint_dermaprev"
                    android:text="A mancha está centralizada na imagem."
                    android:textColor="#173B70"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/checkSemSombra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="@color/checkbox_tint_dermaprev"
                    android:text="A imagem não está escura, estourada ou com sombra forte."
                    android:textColor="#173B70"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Dica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_login"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#0A4BCF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Por que validar a foto?"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Fotos escuras, tremidas ou distantes podem prejudicar a triagem visual."
                        android:textColor="#50627A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btnContinuarValidacao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnRefazerFoto"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary_dermaprev"
                android:backgroundTint="@null"
                android:text="Refazer foto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnVoltarValidacao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_dermaprev"
                android:backgroundTint="@null"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>