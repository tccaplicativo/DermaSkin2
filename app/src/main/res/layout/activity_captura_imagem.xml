<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCapturaImagem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_base">

    <!-- Fundo decorativo: pontinhos -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="8dp"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:src="@drawable/bg_dots_dermaprev" />

    <!-- Fundo decorativo: hexágonos -->
    <ImageView
        android:layout_width="185dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="-38dp"
        android:alpha="0.16"
        android:contentDescription="@null"
        android:src="@drawable/bg_hex_dermaprev" />

    <!-- Fundo decorativo: ondas inferiores -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:layout_gravity="bottom"
        android:alpha="0.28"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_wave_bottom_dermaprev" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- TOPO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Voltar -->
                <ImageButton
                    android:id="@+id/btnVoltarTopoCaptura"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:contentDescription="Voltar"
                    android:elevation="3dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/baseline_chevron_left"
                    app:tint="#60738A" />

                <!-- Marca -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Logo DermaPrev"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_dermaprev" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Derma"
                        android:textColor="#063B78"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prev"
                        android:textColor="#1DB9D2"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Progresso -->
                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_card_login"
                    android:elevation="3dp"
                    android:gravity="center"
                    android:text="2/4"
                    android:textColor="#0A4BCF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TÍTULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Captura da imagem"
                android:textColor="#063B78"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Selecione a região da lesão e prepare a foto para continuar."
                android:textColor="#50627A"
                android:textSize="15sp" />

            <!-- CARD PRINCIPAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card_login"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Área da lesão -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Área da lesão"
                    android:textColor="#063B78"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerAreaLesao"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <!-- Preview -->
                <FrameLayout
                    android:layout_width="243dp"
                    android:layout_height="243dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="22dp">

                    <ImageView
                        android:id="@+id/imgCapturaPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle"
                        android:padding="10dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_skin_placeholder" />

                    <!-- Linha vertical -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:alpha="0.75"
                        android:background="#FFFFFF" />

                    <!-- Linha horizontal -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="center"
                        android:alpha="0.75"
                        android:background="#FFFFFF" />

                    <!-- Área de foco -->
                    <View
                        android:layout_width="131dp"
                        android:layout_height="131dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_focus_ring" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:background="#80063B78"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="centralize aqui"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="A foto será revisada antes da análise."
                    android:textColor="#50627A"
                    android:textSize="13sp" />

                <!-- Abrir câmera -->
                <Button
                    android:id="@+id/btnAbrirCamera"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button_primary_dermaprev"
                    android:backgroundTint="@null"
                    android:text="Abrir câmera"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Usar foto -->
                <Button
                    android:id="@+id/btnUsarFoto"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:backgroundTint="@null"
                    android:enabled="false"
                    android:text="Usar esta foto"
                    android:textAllCaps="false"
                    android:textColor="#0A4BCF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@null" />

                <!-- Tirar outra -->
                <Button
                    android:id="@+id/btnTirarOutra"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_outline_dermaprev"
                    android:backgroundTint="@null"
                    android:enabled="false"
                    android:text="Tirar outra foto"
                    android:textAllCaps="false"
                    android:textColor="#0A4BCF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- DICA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_login"
                android:elevation="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_dermaprev"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="#0A4BCF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dica para uma boa imagem"
                        android:textColor="#063B78"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Evite fotos tremidas, escuras, com muito brilho ou muito distantes."
                        android:textColor="#50627A"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Voltar -->
            <Button
                android:id="@+id/btnVoltarCaptura"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_outline_dermaprev"
                android:backgroundTint="@null"
                android:text="Voltar"
                android:textAllCaps="false"
                android:textColor="#0A4BCF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>